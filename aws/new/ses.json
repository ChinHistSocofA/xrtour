{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Template to create an SES sending user account and corresponding access key",
  "Parameters": {
    "BaseName": {
      "Description": "Base name of the deployment (snake-case, will be prepended to make internal reference names)",
      "Type": "String",
      "Default": "app"
    }
  },
  "Outputs": {
    "SESUserAccessKeyId": {
      "Description": "Access Key ID for the user",
      "Value": {
        "Ref": "SESUserAccessKey"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${BaseName}-ses-user-access-key-id"
        }
      }
    },
    "SESUserSecretAccessKeyARN": {
      "Description": "ARN for the Secrets Manager secret containing the Secret Access Key for the user",
      "Value": {
        "Ref": "SESUserSecretAccessKey"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${BaseName}-ses-user-secret-access-key-arn"
        }
      }
    },
    "DkimDNSTokenName1": {
      "Description": "DNS token name for DKIM 1",
      "Value": {
        "Fn::GetAtt": [
          "SESEmailIdentity",
          "DkimDNSTokenName1"
        ]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${BaseName}-dkim-dns-token-name-1"
        }
      }
    },
    "DkimDNSTokenName2": {
      "Description": "DNS token name for DKIM 2",
      "Value": {
        "Fn::GetAtt": [
          "SESEmailIdentity",
          "DkimDNSTokenName2"
        ]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${BaseName}-dkim-dns-token-name-2"
        }
      }
    },
    "DkimDNSTokenName3": {
      "Description": "DNS token name for DKIM 3",
      "Value": {
        "Fn::GetAtt": [
          "SESEmailIdentity",
          "DkimDNSTokenName3"
        ]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${BaseName}-dkim-dns-token-name-3"
        }
      }
    },
    "DkimDNSTokenValue1": {
      "Description": "DNS token value for DKIM 1",
      "Value": {
        "Fn::GetAtt": [
          "SESEmailIdentity",
          "DkimDNSTokenValue1"
        ]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${BaseName}-dkim-dns-token-value-1"
        }
      }
    },
    "DkimDNSTokenValue2": {
      "Description": "DNS token value for DKIM 2",
      "Value": {
        "Fn::GetAtt": [
          "SESEmailIdentity",
          "DkimDNSTokenValue2"
        ]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${BaseName}-dkim-dns-token-value-2"
        }
      }
    },
    "DkimDNSTokenValue3": {
      "Description": "DNS token value for DKIM 3",
      "Value": {
        "Fn::GetAtt": [
          "SESEmailIdentity",
          "DkimDNSTokenValue3"
        ]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${BaseName}-dkim-dns-token-value-3"
        }
      }
    }
  },
  "Resources": {
    "SESEmailIdentity": {
      "Type": "AWS::SES::EmailIdentity",
      "Properties": {
        "EmailIdentity": {
          "Fn::ImportValue": {
            "Fn::Sub": "${BaseName}-domain"
          }
        },
        "MailFromAttributes": {
          "BehaviorOnMxFailure": "USE_DEFAULT_VALUE",
          "MailFromDomain": {
            "Fn::Join": [
              ".",
              [
                "ses",
                {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${BaseName}-domain"
                  }
                }
              ]
            ]
          }
        }
      }
    },
    "SESUser": {
      "Type": "AWS::IAM::User",
      "Properties": {
        "Policies": [
          {
            "PolicyName": {
              "Fn::Sub": "${BaseName}-ses-policy"
            },
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ses:SendRawEmail",
                  "Resource": "*"
                }
              ]
            }
          }
        ],
        "UserName": {
          "Fn::Sub": "${BaseName}-ses-user"
        }
      }
    },
    "SESUserAccessKey": {
      "Type": "AWS::IAM::AccessKey",
      "Properties": {
        "Status": "Active",
        "UserName": {
          "Ref": "SESUser"
        }
      }
    },
    "SESUserSecretAccessKey": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": {
          "Fn::Sub": "/iam/user/${BaseName}-ses-user/secret-access-key"
        },
        "SecretString": {
          "Fn::GetAtt": [
            "SESUserAccessKey",
            "SecretAccessKey"
          ]
        }
      }
    }
  }
}