{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "EC2 instance with Dokku and LetsEncrypt installed",
  "Outputs": {},
  "Parameters": {
    "BaseName": {
      "Description": "Base name for the stack",
      "Type": "String"
    },
    "DokkuVersion": {
      "Default": "v0.38.24",
      "Description": "Dokku version to install, e.g., \"v0.36.0\" (see https://github.com/dokku/dokku/releases).",
      "Type": "String"
    },
    "ImageUri": {
      "Description": "The URI to the server image to deploy",
      "Type": "String"
    },
    "InstanceImageId": {
      "Description": "The AMI ID for the application server instance",
      "Type": "String"
    },
    "InstanceRootVolumeSize": {
      "Default": "48",
      "Description": "The size of the root volume (in GB).",
      "Type": "Number"
    },
    "InstanceType": {
      "AllowedValues": ["t4g.small", "t4g.medium", "t4g.large"],
      "Default": "t4g.medium",
      "Description": "The application server instance type",
      "Type": "String"
    },
    "FeatureAssetTypes": {
      "Description": "A feature flag to configure supported asset types",
      "Type": "CommaDelimitedList"
    },
    "FeatureRegistration": {
      "Description": "A feature flag to enable/disable user registration",
      "Type": "String",
      "AllowedValues": ["true", "false"]
    },
    "FeatureTransitions": {
      "Description": "A feature flag to enable/disable transitions",
      "Type": "String",
      "AllowedValues": ["true", "false"]
    },
    "GoogleWebfontsApiKey": {
      "Description": "The Google Webfonts API key.",
      "Type": "String"
    },
    "LetsEncryptEmail": {
      "Description": "Email address to use with LetsEncrypt, to receive notifications of SSL cert renewals, etc",
      "Type": "String"
    },
    "MapboxAccessToken": {
      "Description": "The access token for MapBox API",
      "Type": "String"
    },
    "MixpanelToken": {
      "Description": "The access token for Mixpanel analytics",
      "Type": "String"
    },
    "SessionSecret": {
      "Description": "A secret key for signing cookie sessions",
      "Type": "String"
    },
    "SiteTitle": {
      "Description": "The title of the site, used in emails and other notifications.",
      "Type": "String"
    }
  },
  "Resources": {
    "Instance": {
      "Properties": {
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeSize": {
                "Ref": "InstanceRootVolumeSize"
              }
            }
          }
        ],
        "IamInstanceProfile": {
          "Ref": "InstanceProfile"
        },
        "ImageId": {
          "Ref": "InstanceImageId"
        },
        "InstanceType": {
          "Ref": "InstanceType"
        },
        "KeyName": {
          "Ref": "KeyPair"
        },
        "SecurityGroups": [
          {
            "Ref": "InstanceSecurityGroup"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Ref": "AWS::StackName"
            }
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Join": [
              "",
              [
                "#!/bin/bash\n",
                "sudo apt-get update -y\n",
                "sudo apt-get install -y cron\n",
                "wget -NP . https://dokku.com/install/",
                {
                  "Ref": "DokkuVersion"
                },
                "/bootstrap.sh\n",
                "sudo DOKKU_TAG=",
                {
                  "Ref": "DokkuVersion"
                },
                " bash bootstrap.sh\n",
                "dokku builder:set --global selected dockerfile\n",
                "sudo dokku plugin:install https://github.com/dokku/dokku-letsencrypt.git\n",
                "dokku letsencrypt:set --global email ",
                {
                  "Ref": "LetsEncryptEmail"
                },
                "\n",
                "dokku apps:create xrtour\n",
                "dokku config:set xrtour AWS_CLOUDFRONT_DOMAIN=\"",
                {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${BaseName}-cdn-domain"
                  }
                },
                "\" AWS_CLOUDFRONT_KEYPAIR_ID=\"",
                {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${BaseName}-cdn-signing-keypair-id"
                  }
                },
                "\" AWS_CLOUDFRONT_PRIVATE_KEY=\"",
                {
                  "Fn::Join": [
                    "",
                    [
                      "{{resolve:secretsmanager:",
                      {
                        "Fn::ImportValue": {
                          "Fn::Sub": "${BaseName}-cdn-signing-private-key-arn"
                        }
                      },
                      "}}"
                    ]
                  ]
                },
                "\" AWS_SES_REGION=\"",
                {
                  "Ref": "AWS::Region"
                },
                "\" AWS_SES_ACCESS_KEY_ID=\"",
                {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${BaseName}-ses-user-access-key-id"
                  }
                },
                "\" AWS_SES_SECRET_ACCESS_KEY=\"",
                {
                  "Fn::Join": [
                    "",
                    [
                      "{{resolve:secretsmanager:",
                      {
                        "Fn::ImportValue": {
                          "Fn::Sub": "${BaseName}-ses-user-secret-access-key-arn"
                        }
                      },
                      "}}"
                    ]
                  ]
                },
                "\" AWS_S3_ACCESS_KEY_ID=\"",
                {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${BaseName}-bucket-user-access-key-id"
                  }
                },
                "\" AWS_S3_SECRET_ACCESS_KEY=\"",
                {
                  "Fn::Join": [
                    "",
                    [
                      "{{resolve:secretsmanager:",
                      {
                        "Fn::ImportValue": {
                          "Fn::Sub": "${BaseName}-bucket-user-secret-access-key-arn"
                        }
                      },
                      "}}"
                    ]
                  ]
                },
                "\" AWS_S3_BUCKET=\"",
                {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${BaseName}-bucket"
                  }
                },
                "\" AWS_S3_ENDPOINT=\"",
                {
                  "Fn::Join": [
                    "",
                    [
                      "https://s3.",
                      {
                        "Ref": "AWS::Region"
                      },
                      ".amazonaws.com"
                    ]
                  ]
                },
                "\" AWS_S3_REGION=\"",
                {
                  "Ref": "AWS::Region"
                },
                "\" AWS_TRANSCRIBE_REGION=\"",
                {
                  "Ref": "AWS::Region"
                },
                "\" AWS_TRANSCRIBE_ACCESS_KEY_ID=\"",
                {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${BaseName}-bucket-user-access-key-id"
                  }
                },
                "\" AWS_TRANSCRIBE_SECRET_ACCESS_KEY=\"",
                {
                  "Fn::Join": [
                    "",
                    [
                      "{{resolve:secretsmanager:",
                      {
                        "Fn::ImportValue": {
                          "Fn::Sub": "${BaseName}-bucket-user-secret-access-key-arn"
                        }
                      },
                      "}}"
                    ]
                  ]
                },
                "\" AWS_TRANSCRIBE_BUCKET=\"",
                {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${BaseName}-bucket"
                  }
                },
                "\" AWS_TRANSLATE_REGION=\"",
                {
                  "Ref": "AWS::Region"
                },
                "\" AWS_TRANSLATE_ACCESS_KEY_ID=\"",
                {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${BaseName}-bucket-user-access-key-id"
                  }
                },
                "\" AWS_TRANSLATE_SECRET_ACCESS_KEY=\"",
                {
                  "Fn::Join": [
                    "",
                    [
                      "{{resolve:secretsmanager:",
                      {
                        "Fn::ImportValue": {
                          "Fn::Sub": "${BaseName}-bucket-user-secret-access-key-arn"
                        }
                      },
                      "}}"
                    ]
                  ]
                },
                "\" BASE_URL=\"",
                {
                  "Fn::Join": [
                    "",
                    [
                      "https://",
                      {
                        "Fn::ImportValue": {
                          "Fn::Sub": "${BaseName}-domain"
                        }
                      }
                    ]
                  ]
                },
                "\" DATABASE_URL=\"",
                {
                  "Fn::Join": [
                    "",
                    [
                      "postgresql://",
                      {
                        "Fn::Join": [
                          "",
                          [
                            "{{resolve:secretsmanager:",
                            {
                              "Fn::ImportValue": {
                                "Fn::Sub": "${BaseName}-db-master-user-password-secret-arn"
                              }
                            },
                            ":SecretString:username}}"
                          ]
                        ]
                      },
                      ":",
                      {
                        "Fn::Join": [
                          "",
                          [
                            "{{resolve:secretsmanager:",
                            {
                              "Fn::ImportValue": {
                                "Fn::Sub": "${BaseName}-db-master-user-password-secret-arn"
                              }
                            },
                            ":SecretString:password}}"
                          ]
                        ]
                      },
                      "@",
                      {
                        "Fn::ImportValue": {
                          "Fn::Sub": "${BaseName}-db-endpoint"
                        }
                      },
                      ":",
                      {
                        "Fn::ImportValue": {
                          "Fn::Sub": "${BaseName}-db-port"
                        }
                      },
                      "/xrtour?sslmode=no-verify"
                    ]
                  ]
                },
                "\" MIXPANEL_TOKEN=\"",
                {
                  "Ref": "MixpanelToken"
                },
                "\" SESSION_SECRET=\"",
                {
                  "Ref": "SessionSecret"
                },
                "\" SMTP_ENABLED=true SMTP_FROM_EMAIL_ADDRESS=\"",
                {
                  "Fn::Join": [
                    "",
                    [
                      "no-reply@",
                      {
                        "Fn::ImportValue": {
                          "Fn::Sub": "${BaseName}-domain"
                        }
                      }
                    ]
                  ]
                },
                "\" VITE_FEATURE_ASSET_TYPES=\"",
                {
                  "Fn::Join": [
                    ",",
                    {
                      "Ref": "FeatureAssetTypes"
                    }
                  ]
                },
                "\" VITE_FEATURE_REGISTRATION=\"",
                {
                  "Ref": "FeatureRegistration"
                },
                "\" VITE_FEATURE_TRANSITIONS=\"",
                {
                  "Ref": "FeatureTransitions"
                },
                "\" VITE_GOOGLE_WEBFONTS_API_KEY=\"",
                {
                  "Ref": "GoogleWebfontsApiKey"
                },
                "\" VITE_MAPBOX_ACCESS_TOKEN=\"",
                {
                  "Ref": "MapboxAccessToken"
                },
                "\" VITE_SITE_TITLE=\"",
                {
                  "Ref": "SiteTitle"
                },
                "\"\ndokku git:from-image xrtour ",
                {
                  "Ref": "ImageUri"
                },
                "\ndokku run xrtour \"cd server; npx prisma migrate deploy\"\n",
                "dokku domains:add xrtour ",
                {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${BaseName}-domain"
                  }
                },
                " *.",
                {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${BaseName}-domain"
                  }
                },
                " *.staging.",
                {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${BaseName}-domain"
                  }
                },
                "\ndokku letsencrypt:enable xrtour\n"
              ]
            ]
          }
        }
      },
      "Type": "AWS::EC2::Instance"
    },
    "InstanceSecurityGroup": {
      "Properties": {
        "GroupDescription": "Allow http/https/ssh traffic",
        "GroupName": {
          "Fn::Sub": "${ApplicationName}-ec2-sg"
        },
        "SecurityGroupIngress": [
          {
            "CidrIp": "0.0.0.0/0",
            "FromPort": 80,
            "IpProtocol": "tcp",
            "ToPort": 80
          },
          {
            "CidrIp": "0.0.0.0/0",
            "FromPort": 443,
            "IpProtocol": "tcp",
            "ToPort": 443
          },
          {
            "CidrIp": "0.0.0.0/0",
            "FromPort": 22,
            "IpProtocol": "tcp",
            "ToPort": 22
          }
        ],
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${BaseName}-vpc-id"
          }
        }
      },
      "Type": "AWS::EC2::SecurityGroup"
    },
    "InstanceElasticIPAssociation": {
      "Properties": {
        "AllocationId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${BaseName}-elastic-ip-0-allocation-id"
          }
        },
        "InstanceId": {
          "Ref": "Instance"
        }
      },
      "Type": "AWS::EC2::EIPAssociation"
    },
    "DatabaseIngressFromInstance": {
      "Properties": {
        "SourceSecurityGroupId": {
          "Fn::GetAtt": ["InstanceSecurityGroup", "GroupId"]
        },
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432,
        "GroupId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${BaseName}-db-sg-id"
          }
        }
      },
      "Type": "AWS::EC2::SecurityGroupIngress"
    },
    "KeyPair": {
      "Properties": {
        "KeyName": {
          "Fn::Sub": "${ApplicationName}-ec2-key-pair"
        }
      },
      "Type": "AWS::EC2::KeyPair"
    }
  }
}
