{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Template to create a new RDS database",
  "Parameters": {
    "BaseName": {
      "Description": "Base name for the stack",
      "Type": "String"
    },
    "DBInstanceType": {
      "Description": "The DB instance type",
      "Type": "String",
      "Default": "db.t4g.small",
      "AllowedValues": ["db.t4g.micro", "db.t4g.small", "db.t4g.medium", "db.t4g.large"]
    }
  },
  "Outputs": {
    "DatabaseResourceId": {
      "Description": "The Resource ID of the database",
      "Value": {
        "Fn::GetAtt": ["Database", "DbiResourceId"]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${BaseName}-db-resource-id"
        }
      }
    },
    "DatabaseSecurityGroupId": {
      "Description": "The ID of the security group for the database",
      "Value": {
        "Ref": "DatabaseSecurityGroup"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${BaseName}-db-sg-id"
        }
      }
    },
    "DatabaseEndpoint": {
      "Description": "The endpoint of the database",
      "Value": {
        "Fn::GetAtt": ["Database", "Endpoint.Address"]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${BaseName}-db-endpoint"
        }
      }
    },
    "DatabasePort": {
      "Description": "The port of the database",
      "Value": {
        "Fn::GetAtt": ["Database", "Endpoint.Port"]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${BaseName}-db-port"
        }
      }
    },
    "DatabaseMasterUserPasswordSecretArn": {
      "Description": "The ARN of the secret containing the master user password",
      "Value": {
        "Ref": "DatabaseMasterUserPasswordSecret"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${BaseName}-db-master-user-password-secret-arn"
        }
      }
    }
  },
  "Resources": {
    "DatabaseMasterUserPasswordSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": {
          "Fn::Sub": "/rds/db/${BaseName}/master-user-credentials"
        },
        "GenerateSecretString": {
          "SecretStringTemplate": {
            "Fn::Sub": "{\"username\":\"${BaseName}\"}"
          },
          "GenerateStringKey": "password",
          "PasswordLength": 32,
          "ExcludePunctuation": true
        }
      }
    },
    "DatabaseSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupName": {
          "Fn::Sub": "${BaseName}-db-sg"
        },
        "GroupDescription": "Allow postgres inbound traffic",
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${BaseName}-vpc-id"
          }
        }
      }
    },
    "DatabaseSubnetGroup": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupName": {
          "Fn::Sub": "${BaseName}-db-subnet-group"
        },
        "DBSubnetGroupDescription": "Subnet group for the RDS DB instance",
        "SubnetIds": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${BaseName}-private-subnet-az0-id"
            }
          },
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${BaseName}-private-subnet-az1-id"
            }
          }
        ]
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "AllocatedStorage": 20,
        "DBInstanceClass": {
          "Ref": "DBInstanceType"
        },
        "DBInstanceIdentifier": {
          "Fn::Sub": "${BaseName}-db"
        },
        "DBName": "xrtour",
        "DBSubnetGroupName": {
          "Ref": "DatabaseSubnetGroup"
        },
        "Engine": "postgres",
        "EngineVersion": "17.6",
        "MasterUsername": "xrtour",
        "MasterUserPassword": {
          "Fn::Join": [
            "",
            [
              "{{resolve:secretsmanager:",
              {
                "Ref": "DatabaseMasterUserPasswordSecret"
              },
              ":SecretString:password}}"
            ]
          ]
        },
        "MaxAllocatedStorage": 40,
        "StorageEncrypted": true,
        "VPCSecurityGroups": [
          {
            "Fn::GetAtt": ["DatabaseSecurityGroup", "GroupId"]
          }
        ]
      },
      "UpdateReplacePolicy": "Snapshot",
      "DeletionPolicy": "Snapshot"
    }
  }
}
