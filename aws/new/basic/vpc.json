{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Template to set up a VPC with subnets, route tables, and an Elastic IP",
  "Parameters": {
    "BaseName": {
      "Description": "Base name for the stack",
      "Type": "String"
    },
    "Domain": {
      "Description": "Base domain name for the deployment",
      "Type": "String"
    }
  },
  "Outputs": {
    "VPCId": {
      "Description": "ID of the VPC",
      "Value": {
        "Ref": "VPC"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${BaseName}-vpc-id"
        }
      }
    },
    "PublicSubnetAZ0Id": {
      "Description": "ID of the public subnet in availability zone 0",
      "Value": {
        "Ref": "PublicSubnetAZ0"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${BaseName}-public-subnet-az0-id"
        }
      }
    },
    "PublicSubnetAZ1Id": {
      "Description": "ID of the public subnet in availability zone 1",
      "Value": {
        "Ref": "PublicSubnetAZ1"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${BaseName}-public-subnet-az1-id"
        }
      }
    },
    "PrivateSubnetAZ0Id": {
      "Description": "ID of the private subnet in availability zone 0",
      "Value": {
        "Ref": "PrivateSubnetAZ0"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${BaseName}-private-subnet-az0-id"
        }
      }
    },
    "PrivateSubnetAZ1Id": {
      "Description": "ID of the private subnet in availability zone 1",
      "Value": {
        "Ref": "PrivateSubnetAZ1"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${BaseName}-private-subnet-az1-id"
        }
      }
    },
    "ElasticIP0AllocationId": {
      "Description": "Elastic IP 0 allocation ID",
      "Value": {
        "Fn::GetAtt": [
          "ElasticIP0",
          "AllocationId"
        ]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${BaseName}-elastic-ip-0-allocation-id"
        }
      }
    },
    "ElasticIP0PublicIP": {
      "Description": "Public IP address of the Elastic IP 0",
      "Value": {
        "Fn::GetAtt": [
          "ElasticIP0",
          "PublicIp"
        ]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${BaseName}-elastic-ip-0-public-ip"
        }
      }
    },
    "Domain": {
      "Description": "The original domain name specified in the parameters",
      "Value": {
        "Ref": "Domain"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${BaseName}-domain"
        }
      }
    }
  },
  "Resources": {
    "VPC": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "172.31.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "InstanceTenancy": "default"
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway"
    },
    "VPCInternetGatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        },
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "ElasticIP0": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc"
      },
      "DependsOn": "VPC"
    },
    "PublicRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        }
      }
    },
    "PublicSubnetAZ0": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        },
        "CidrBlock": "172.31.0.0/20",
        "AvailabilityZone": {
          "Fn::Select": [
            "0",
            {
              "Fn::GetAZs": ""
            }
          ]
        }
      }
    },
    "PublicSubnetAZ1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        },
        "CidrBlock": "172.31.16.0/20",
        "AvailabilityZone": {
          "Fn::Select": [
            "1",
            {
              "Fn::GetAZs": ""
            }
          ]
        }
      }
    },
    "PrivateSubnetAZ0": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        },
        "CidrBlock": "172.31.32.0/20",
        "AvailabilityZone": {
          "Fn::Select": [
            "0",
            {
              "Fn::GetAZs": ""
            }
          ]
        }
      }
    },
    "PrivateSubnetAZ1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        },
        "CidrBlock": "172.31.48.0/20",
        "AvailabilityZone": {
          "Fn::Select": [
            "1",
            {
              "Fn::GetAZs": ""
            }
          ]
        }
      }
    },
    "PublicRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      },
      "DependsOn": "VPCInternetGatewayAttachment"
    },
    "PublicSubnetRouteTableAssociationAZ0": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnetAZ0"
        },
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        }
      }
    },
    "PublicSubnetRouteTableAssociationAZ1": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnetAZ1"
        },
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        }
      }
    }
  }
}